{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
      }
    },
    "usernames": {
      ".read": true,
      "$n": {
        ".write": "(auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
      }
    },
    "emails": {
      "$n": {
        ".read": true,
        ".write": "(auth != null && (root.child('usernames').child($n).child('uid').val() === auth.uid || newData.parent().parent().child('usernames').child($n).child('uid').val() === auth.uid)) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
      }
    },
    "posts": {
      ".read": "auth != null",
      "$pid": {
        ".write": "(auth != null && (data.exists() ? data.child('uid').val() === auth.uid : newData.child('uid').val() === auth.uid)) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))",
        "likes": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "likedBy": {
          "$u": {
            ".write": "auth != null && auth.uid === $u"
          }
        },
        "comments": {
          "$cid": {
            ".write": "(auth != null && (data.exists() ? (data.child('uid').val() === auth.uid || root.child('posts').child($pid).child('uid').val() === auth.uid) : newData.child('uid').val() === auth.uid)) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))",
            "likedBy": {
              "$u": {
                ".write": "auth != null && auth.uid === $u"
              }
            },
            "replies": {
              "$rid": {
                ".write": "(auth != null && (data.exists() ? (data.child('uid').val() === auth.uid || root.child('posts').child($pid).child('uid').val() === auth.uid) : newData.child('uid').val() === auth.uid)) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
              }
            }
          }
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.uid === $uid) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))",
        "$nid": {
          ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid"
        }
      }
    },
    "stories": {
      ".read": "auth != null",
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))",
        "$sid": {
          "viewers": {
            "$v": {
              ".write": "auth != null && auth.uid === $v"
            }
          }
        }
      }
    },
    "storyMedia": {
      ".read": "auth != null",
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
      }
    },
    "following": {
      ".read": "auth != null",
      "$uid": {
        ".write": "(auth != null && auth.uid === $uid) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
      }
    },
    "followers": {
      ".read": "auth != null",
      "$uid": {
        "$f": {
          ".write": "auth != null && auth.uid === $f"
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chat": {
          ".write": "auth != null && (auth.uid === $uid || (($chat.beginsWith(auth.uid + '_') || $chat.endsWith('_' + auth.uid)) && !root.child('users').child($uid).child('blocked').child(auth.uid).exists()))"
        }
      }
    },
    "chats": {
      "$chat": {
        ".read": "auth != null && ($chat.beginsWith(auth.uid + '_') || $chat.endsWith('_' + auth.uid))",
        ".write": "(auth != null && ($chat.beginsWith(auth.uid + '_') || $chat.endsWith('_' + auth.uid)) && !root.child('users').child($chat.replace(auth.uid, '').replace('_', '')).child('blocked').child(auth.uid).exists()) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "crashReports": {
      ".read": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))",
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))",
      "$r": {
        ".write": "auth != null && (!data.exists() || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists())))"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$a": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === $a && !root.child('admins').exists()))"
      }
    },
    "bans": {
      ".read": "auth != null",
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))"
    },
    "reports": {
      ".read": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))",
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists()))",
      "$r": {
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
